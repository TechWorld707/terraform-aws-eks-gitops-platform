# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
*.plan

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform CLI configuration
.terraformrc
terraform.rc

# Terraform crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local backend configuration
backend.hcl
!backend.hcl.example

# Environment and credential files
.env
.env.*
!.env.example
*.pem
*.key

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
