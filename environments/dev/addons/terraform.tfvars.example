aws_region   = "us-east-1"
project_name = "three-tier-eks"
environment  = "dev"

foundation_state_bucket = "REPLACE_WITH_TERRAFORM_STATE_BUCKET"
foundation_state_key    = "eks-gitops/dev/foundation/terraform.tfstate"

# Leave empty to let EKS select compatible default add-on versions.
addon_versions = {}

load_balancer_controller_chart_version = "1.14.0"
load_balancer_controller_replicas      = 2

tags = {
  Owner = "platform-engineering"
}

external_dns_hosted_zone_ids = [
  "Z1234567890EXAMPLE"
]

external_dns_domain_filters = [
  "dev.example.com"
]

external_dns_chart_version = "1.21.1"
external_dns_policy        = "upsert-only"
external_dns_txt_owner_id  = "three-tier-eks-dev"